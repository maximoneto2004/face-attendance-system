# Copie para .env e preencha. Nunca commite o .env.

# PostgreSQL. Para desenvolvimento local sem instalar nada: `npx prisma dev`
# (imprime a URL). Ou use um Postgres próprio/Docker/Neon/Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/face_attendance"

# Segredo para assinar o cookie de sessão (>= 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# AWS Rekognition. Localmente use um usuário IAM com a policy mínima do README.
# Em produção prefira credenciais temporárias (IAM Role / OIDC) e deixe as chaves vazias.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REKOGNITION_COLLECTION_ID=face-attendance

# Limiares de similaridade (0-100) do reconhecimento facial.
# >= AUTO_ACCEPT: reconhecido automaticamente. Entre REVIEW e AUTO_ACCEPT: sugestão
# para o professor confirmar. Abaixo de REVIEW: tratado como desconhecido.
FACE_AUTO_ACCEPT_THRESHOLD=95
FACE_REVIEW_THRESHOLD=85
